---
interface Props {
  heading?: string;
  sub?: string;
}

const {
  heading = "Get three fixes for your website. Free.",
  sub = "Send us your website and your main goal. You'll get a short video with the three changes to make first. No call required, no obligation.",
} = Astro.props;
---

<section class="section section--dark cta-band" id="contact">
  <div class="container cta-band__inner" data-rise>
    <h2 class="cta-band__heading">{heading}</h2>
    <p class="lead cta-band__sub">{sub}</p>
    <div class="cta-band__actions">
      <a href="/contact?intent=review" class="btn btn--accent btn--lg">Get a Free Website Review</a>
      <a href="/work" class="btn btn--ghost-light btn--lg">See Our Work</a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .cta-band__heading {
    font-size: clamp(32px, 4.5vw, 52px);
    max-width: 720px;
  }

  .cta-band__sub {
    max-width: 560px;
  }

  .cta-band__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-1);
  }
</style>
