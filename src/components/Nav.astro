---
const links = [
  { href: "/work", label: "Work" },
  { href: "/services", label: "Services" },
  { href: "/blog", label: "Blog" },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="Dee7 Studio home">
      <img src="/brand/wordmark-on-light.svg" alt="Dee7 Studio" width="115" height="36" class="nav__wordmark" />
    </a>

    <nav class="nav__links" aria-label="Main">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav__link", { "nav__link--active": path.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/contact?intent=review" class="btn btn--accent nav__cta">Free Website Review</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 240, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 72px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  .nav__wordmark {
    height: 36px;
    width: auto;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
  }

  .nav__link {
    position: relative;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    transition: color var(--ease);
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--ink);
  }

  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -8px;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-text);
  }

  .nav__cta {
    font-size: 14px;
    padding: 10px 20px;
  }

  @media (max-width: 720px) {
    .nav__inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: 12px 10px;
      row-gap: 10px;
      column-gap: 10px;
      justify-content: space-between;
    }

    .nav__links {
      order: 3;
      width: 100%;
      gap: var(--space-3);
    }

    .nav__link--active::after {
      bottom: -6px;
    }

    .nav__cta {
      font-size: 13px;
      padding: 8px 14px;
    }

    .nav__wordmark {
      height: 32px;
    }
  }

  /* Below ~360px, the wordmark + "Free Website Review" pill no longer fit on
     one row at the 720px breakpoint's sizing, which forces the CTA onto its
     own line and gives the header 3 rows instead of 2. Trim the CTA a little
     further so it keeps sitting beside the logo down to the narrowest common
     phone widths. */
  @media (max-width: 374px) {
    .nav__cta {
      font-size: 12px;
      padding: 7px 10px;
    }

    .nav__wordmark {
      height: 28px;
    }
  }
</style>
