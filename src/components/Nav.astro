---
const links = [
  { href: "/work", label: "Work" },
  { href: "/services", label: "Services" },
  { href: "/blog", label: "Blog" },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="Dee7 Studio home">
      <img src="/brand/wordmark-on-light.svg" alt="Dee7 Studio" width="115" height="36" class="nav__wordmark" />
    </a>

    <nav class="nav__links" aria-label="Main">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav__link", { "nav__link--active": path.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/contact" class="btn btn--accent nav__cta">Get a Free Review</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(252, 252, 249, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 72px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  .nav__wordmark {
    height: 36px;
    width: auto;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
  }

  .nav__link {
    position: relative;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    transition: color var(--ease);
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--ink);
  }

  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -8px;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav__cta {
    font-size: 14px;
    padding: 10px 20px;
  }

  @media (max-width: 720px) {
    .nav__links {
      display: none;
    }
  }
</style>
