---
import { SITE } from "../lib/site";
const year = new Date().getFullYear();
---

<script>
  const el = document.querySelector("[data-clock]");
  if (el) {
    const fmt = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Prague",
    });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>

<footer class="footer">
  <div class="container">
    <div class="footer__live">
      <span class="status footer__status">
        <span class="status__dot"></span>
        Taking on new projects
      </span>
      <span class="footer__live-item">Award-winning work, live at lobelia.earth</span>
      <span class="footer__live-item">Certified Webflow &amp; Notion Partner</span>
      <span class="footer__clock"><span data-clock>--:--</span> CET, studio time</span>
    </div>

    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__brand-row">
          <img src="/brand/wordmark-on-dark.svg" alt="Dee7 Studio" width="144" height="45" class="footer__wordmark" />
        </div>
        <p class="footer__tagline">Websites that explain your offer and get visitors to act.</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div class="footer__col">
          <span class="footer__col-title">Studio</span>
          <a href="/work">Work</a>
          <a href="/services">Services</a>
          <a href="/#process">Process</a>
        </div>
        <div class="footer__col">
          <span class="footer__col-title">Resources</span>
          <a href="/blog">Blog</a>
          <a href="/contact?intent=review">Free Website Review</a>
        </div>
        <div class="footer__col">
          <span class="footer__col-title">Contact</span>
          <a href="/contact">Start a project</a>
          <a href={SITE.bookingUrl} target="_blank" rel="noopener">Book a call</a>
          <a href="mailto:hello@dee7studio.com">hello@dee7studio.com</a>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <span>© {year} Dee7 Studio. All rights reserved.</span>
      <span>Certified Webflow Partner · Certified Notion Partner</span>
      <span class="footer__legal">
        <a href="/privacy">Privacy</a>
        <button type="button" class="footer__link-btn" data-consent-open>Cookie settings</button>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--ink-contrast);
    padding-block: var(--space-6) var(--space-4);
    border-top: 1px solid var(--border-on-dark);
  }

  .footer__live {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-on-dark);
    font-size: 13px;
  }

  .footer__status {
    color: var(--ink-contrast);
  }

  .footer__live-item {
    color: var(--muted-on-dark);
  }

  .footer__clock {
    margin-left: auto;
    color: var(--muted-on-dark);
    font-variant-numeric: tabular-nums;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-on-dark);
  }

  .footer__brand-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__wordmark {
    height: 45px;
    width: auto;
  }

  .footer__tagline {
    margin-top: var(--space-2);
    color: var(--muted-on-dark);
    font-size: 14px;
  }

  .footer__cols {
    display: flex;
    column-gap: var(--space-8);
    row-gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }

  .footer__col a {
    color: var(--muted-on-dark);
    transition: color var(--ease);
  }

  .footer__col a:hover {
    color: var(--ink-contrast);
  }

  .footer__col-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-contrast);
    margin-bottom: 4px;
  }

  .footer__legal {
    display: inline-flex;
    gap: var(--space-3);
  }

  .footer__legal a,
  .footer__link-btn {
    color: var(--muted-on-dark);
    transition: color var(--ease);
  }

  .footer__legal a:hover,
  .footer__link-btn:hover {
    color: var(--ink-contrast);
  }

  .footer__link-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    font-size: 12px;
    color: var(--muted-on-dark);
  }
</style>
