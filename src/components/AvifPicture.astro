---
/**
 * <picture> that serves the optimized AVIF first. The fallback <img> goes in
 * the slot, so the page keeps control of its class, alt and loading.
 *
 *   <AvifPicture src={project.image} sizes="400px">
 *     <img src={fallback(project.image)} alt="..." class="shot" />
 *   </AvifPicture>
 */
import { avif } from "../lib/images";

interface Props {
  src?: string;
  sizes: string;
}

const { src, sizes } = Astro.props;
const a = avif(src, sizes);
---

<picture>
  {a && <source type="image/avif" srcset={a.srcset} sizes={a.sizes} />}
  <slot />
</picture>
