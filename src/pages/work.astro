---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { getProjects } from "../lib/content";

const projects = await getProjects();

const capabilities = [
  "Landing Page Design",
  "Web Design",
  "Conversion Copywriting",
  "CRO Audits",
  "Design Systems",
  "Webflow & Astro Development",
  "Product UI",
  "Brand Assets",
];
---

<Base
  title="Work — Dee7 Studio"
  description="Case studies from HealthTech, EdTech and Fintech: conversion lifts, pipeline generated and the design decisions behind them."
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Portfolio</span>
      <h1 class="display page-hero__title">Proof, in numbers.</h1>
      <p class="lead page-hero__sub">
        Every project below shipped with a measurable goal. Here's what moved —
        and the design decisions that moved it.
      </p>
    </div>
  </section>

  <!-- Case studies -->
  <section class="section case-list">
    <div class="container">
      <div class="case-rows">
        {projects.map((project, i) => (
          <a href={`/work/${project.slug}`} class:list={["case-row", { "case-row--flip": i % 2 === 1 }]}>
            <div class="case-row__cover">
              <span class="case-row__metric">{project.metric}</span>
              <span class="case-row__metric-label">{project.metricLabel}</span>
            </div>
            <div class="case-row__body">
              <div class="case-row__tags">
                <span class="badge badge--outline">{project.industry}</span>
                <span class="badge badge--outline">{project.year}</span>
              </div>
              <h2 class="case-row__title">{project.title}</h2>
              <p class="case-row__summary">{project.summary}</p>
              <div class="case-row__services">
                {project.services.map((s) => (
                  <span class="badge badge--tint">{s}</span>
                ))}
              </div>
              <span class="case-row__link">Read the case study →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>What we do, end to end</h2>
      </div>
      <ul class="cap-list">
        {capabilities.map((cap) => (
          <li class="cap-list__item">{cap}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    heading="Want numbers like these?"
    sub="Tell us your conversion goal. We'll tell you — free — whether your current site can hit it, and what we'd change."
  />
</Base>

<style>
  .page-hero {
    padding-block: var(--space-section) var(--space-6);
  }

  .page-hero__title {
    margin-block: var(--space-2);
  }

  .case-list {
    padding-top: 0;
  }

  .case-rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-row {
    display: grid;
    grid-template-columns: 5fr 7fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color var(--ease);
  }

  .case-row:hover {
    border-color: var(--accent);
  }

  .case-row--flip {
    grid-template-columns: 7fr 5fr;
  }

  .case-row--flip .case-row__cover {
    order: 2;
  }

  .case-row__cover {
    background: var(--ink);
    color: var(--ink-contrast);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-6);
    min-height: 280px;
  }

  .case-row__metric {
    font-family: var(--font-display);
    font-size: clamp(56px, 7vw, 96px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }

  .case-row__metric-label {
    font-size: 15px;
    color: var(--muted-on-dark);
  }

  .case-row__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .case-row__tags {
    display: flex;
    gap: var(--space-1);
  }

  .case-row__title {
    font-size: clamp(22px, 2.5vw, 28px);
  }

  .case-row__summary {
    font-size: 15px;
    color: var(--muted);
  }

  .case-row__services {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .case-row__link {
    margin-top: var(--space-1);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .case-row,
    .case-row--flip {
      grid-template-columns: 1fr;
    }

    .case-row--flip .case-row__cover {
      order: 0;
    }

    .case-row__cover {
      min-height: 200px;
      padding: var(--space-4);
    }

    .case-row__body {
      padding: var(--space-4);
    }
  }

  .cap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cap-list__item {
    padding: 12px 24px;
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: border-color var(--ease), color var(--ease);
  }

  .cap-list__item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
