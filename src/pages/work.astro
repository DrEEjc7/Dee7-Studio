---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import AvifPicture from "../components/AvifPicture.astro";
import { getProjects } from "../lib/content";
import { fallback } from "../lib/images";

const projects = await getProjects();

const capabilities = [
  "Landing Page Design",
  "Web Design",
  "Webflow Development",
  "Astro Development",
  "Conversion Copywriting",
  "E-commerce",
  "Localization",
  "Design Systems",
  "Notion Workspaces",
];
---

<Base
  title="Work | Dee7 Studio"
  description="Live, shipped work: award-winning websites across SaaS, climate, e-commerce, education and industry. 10+ years, 2,000+ projects."
  breadcrumbs={[{ name: "Work", path: "/work" }]}
>
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Portfolio</span>
      <h1 class="display page-hero__title">Selected work.</h1>
      <p class="lead page-hero__sub">
        Websites, landing pages and product design for SaaS, health, education
        and enterprise teams. 10+ years, 2,000+ projects, including
        award-winning work. Shipped sites link out, so visit them.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section class="section case-list">
    <div class="container">
      <div class="grid grid--2">
        {projects.map((project, i) => {
          const caseHref =
            Array.isArray(project.body) && project.body.length > 0
              ? `/work/${project.slug}`
              : undefined;
          const href = caseHref ?? project.url;
          const external = !caseHref && Boolean(project.url);
          const Tag = href ? "a" : "article";
          return (
          <Tag
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="card project-tile"
            data-rise
            style={`--rise-delay: ${(i % 2) * 90}ms`}
          >
            <div class="project-tile__cover">
              <div class="project-tile__cover-top">
                <span class="index-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="project-tile__highlight">{project.highlight}</span>
              </div>
              {project.image ? (
                <AvifPicture src={project.image} sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1024px) 50vw, 400px">
                  <img
                    src={fallback(project.image, 800)}
                    alt={`Screenshot of the ${project.title} website`}
                    loading="lazy"
                    decoding="async"
                    class="project-tile__shot"
                  />
                </AvifPicture>
              ) : (
                <span class="project-tile__name">{project.title}</span>
              )}
            </div>
            <div class="project-tile__body">
              <h3 class="project-tile__title">{project.title}</h3>
              <div class="project-tile__tags">
                <span class="badge badge--outline">{project.industry}</span>
                {project.services.map((s) => (
                  <span class="badge badge--tint">{s}</span>
                ))}
              </div>
              <p class="project-tile__summary">{project.summary}</p>
              {caseHref ? (
                <span class="project-tile__link link-cue">Read the case study →</span>
              ) : project.url ? (
                <span class="project-tile__link link-cue">Visit live site ↗</span>
              ) : null}
            </div>
          </Tag>
          );
        })}
      </div>

      <p class="case-note">
        Most projects open a full case study: the problem, what we changed,
        and what shipped. Want the details on something specific?
        <a href="/contact" class="case-note__link link-cue">Ask us</a>.
      </p>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>What we do, end to end</h2>
      </div>
      <ul class="cap-list">
        {capabilities.map((cap) => (
          <li class="cap-list__item">{cap}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    heading="Want work like this?"
    sub="Tell us what you're building and what it needs to do. We'll reply within one business day with an honest recommendation."
  />
</Base>

<style>
  .page-hero {
    padding-block: var(--space-section) var(--space-6);
  }

  .page-hero__title {
    margin-block: var(--space-2);
  }

  .case-list {
    padding-top: 0;
  }

  .project-tile {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-tile__cover {
    background: var(--ink);
    color: var(--ink-contrast);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-tile__cover-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .project-tile__shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
  }

  .project-tile__title {
    font-size: 24px;
  }

  .project-tile__highlight {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text-on-dark);
  }

  .project-tile__cover .index-num {
    color: var(--accent-text-on-dark);
  }

  .project-tile__name {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    padding-block: var(--space-6);
  }

  .project-tile__body {
    padding: var(--space-3) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
    flex: 1;
  }

  .project-tile__tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .project-tile__summary {
    font-size: 15px;
    color: var(--muted);
    flex: 1;
  }

  .project-tile__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }

  .case-note {
    margin-top: var(--space-6);
    font-size: 14px;
    color: var(--muted);
    max-width: none;
    text-align: center;
  }

  .case-note__link {
    color: var(--accent-text);
    font-weight: 600;
  }

  .cap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cap-list__item {
    padding: 12px 24px;
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: border-color var(--ease), color var(--ease);
  }

  .cap-list__item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
