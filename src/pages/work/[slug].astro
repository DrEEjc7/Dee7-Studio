---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Base title={`${project.client} — Case Study — Dee7 Studio`} description={project.summary}>
  <!-- Case hero -->
  <article>
    <header class="case-hero">
      <div class="container case-hero__inner">
        <div class="case-hero__tags">
          <span class="badge badge--delivery">{project.industry}</span>
          <span class="badge badge--outline-dark">{project.year}</span>
        </div>
        <h1 class="case-hero__title">{project.title}</h1>
        <p class="lead case-hero__summary">{project.summary}</p>

        <dl class="case-hero__results">
          {project.results.map((r) => (
            <div class="case-hero__result">
              <dd>{r.value}</dd>
              <dt>{r.label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <!-- Narrative -->
    <section class="section case-body">
      <div class="container">
        <div class="case-section">
          <div class="case-section__label">
            <span class="eyebrow">01 — The Challenge</span>
          </div>
          <div class="case-section__content">
            <p>{project.challenge}</p>
          </div>
        </div>

        <div class="case-section">
          <div class="case-section__label">
            <span class="eyebrow">02 — The Approach</span>
          </div>
          <div class="case-section__content">
            <p>{project.approach}</p>
            <div class="case-section__services">
              {project.services.map((s) => (
                <span class="badge badge--tint">{s}</span>
              ))}
            </div>
          </div>
        </div>

        <div class="case-section">
          <div class="case-section__label">
            <span class="eyebrow">03 — The Results</span>
          </div>
          <div class="case-section__content">
            <div class="case-results-grid">
              {project.results.map((r) => (
                <div class="card case-result">
                  <span class="case-result__value">{r.value}</span>
                  <span class="case-result__label">{r.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <CtaBand
    heading="Your numbers could be next."
    sub="Get a free teardown of your current site — what's leaking, what to fix first, and what lift to expect."
  />
</Base>

<style>
  .case-hero {
    background: var(--ink);
    color: var(--ink-contrast);
    padding-block: var(--space-section);
  }

  .case-hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .case-hero__tags {
    display: flex;
    gap: var(--space-1);
  }

  .badge--outline-dark {
    border: 1px solid var(--border-on-dark);
    color: var(--muted-on-dark);
  }

  .case-hero__title {
    font-size: clamp(32px, 5vw, 56px);
    max-width: 880px;
  }

  .case-hero__summary {
    max-width: 640px;
  }

  .case-hero__results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    width: 100%;
    margin: var(--space-4) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-on-dark);
  }

  .case-hero__result dd {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--accent);
  }

  .case-hero__result dt {
    font-size: 13px;
    color: var(--muted-on-dark);
  }

  @media (max-width: 640px) {
    .case-hero__results {
      grid-template-columns: 1fr;
    }
  }

  .case-body {
    display: flex;
    flex-direction: column;
  }

  .case-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .case-section:last-child {
    border-bottom: none;
  }

  .case-section__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-section__content p {
    font-size: 18px;
    line-height: 1.7;
  }

  .case-section__services {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .case-results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .case-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .case-result__value {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .case-result__label {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .case-section {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .case-results-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
