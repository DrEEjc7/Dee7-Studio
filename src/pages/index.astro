---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { getProjects, getOffers } from "../lib/content";

const projects = (await getProjects()).filter((p) => p.featured).slice(0, 3);
const allOffers = await getOffers();
const offers = allOffers.filter((o) => o.slug !== "website-roadmap");
const roadmap = allOffers.find((o) => o.slug === "website-roadmap");

const steps = [
  {
    n: "01",
    title: "Understand",
    text: "We start with your business: who your customers are, what they need to understand, and what they should do next.",
  },
  {
    n: "02",
    title: "Message",
    text: "Copy before pixels. The structure and words come from your buyers, not from a template.",
  },
  {
    n: "03",
    title: "Design",
    text: "Custom design on a strict system. Every section earns its place or gets cut.",
  },
  {
    n: "04",
    title: "Ship",
    text: "Built in Webflow or Astro, with training so your team can update content without us.",
  },
];

const testimonials = [
  {
    text: "There are designers out there (millions) but only a few truly excellent designers. Andrej is one of those few. … Yes, he charges a fee well above average, but you can expect a result that justifies the premium price. Highly recommended.",
    name: "Jonah Smith",
    company: "Vespa",
  },
  {
    text: "Andrej was very receptive to the ideas I had in my mind, which he spun into an even better result from wireframe to final site design. The project went superbly well and I'm delighted with the results. Andrej is an A+ collaborator and brilliant designer. Definitely, definitely go with him!",
    name: "Dan Denegre",
    company: "Space Race Studio",
  },
  {
    text: "Andrej and his team were fantastic to work with. They worked through feedback very efficiently and were highly communicative throughout the entire process. Will definitely work with them in the future and would highly recommend them to anyone looking for a top-notch Webflow website.",
    name: "Oscar Alcantara",
    company: "EventScouts AG",
  },
];

const sectors = [
  "SaaS",
  "Healthcare",
  "Education",
  "Climate",
  "E-commerce",
  "Travel",
  "Industrial",
  "Agencies",
];
---

<Base title="Dee7 Studio | Websites That Explain Your Product and Win You Customers">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <h1 class="hero__title">
        <span class="hero__line">Make your product</span>
        <span class="hero__line">impossible to <span class="accent-word">misunderstand.</span></span>
      </h1>
      <p class="lead hero__sub">
        You have a product to launch, a website that undersells you, or an idea
        that needs direction. Dee7 plans, writes, designs and builds websites
        that explain your offer clearly, and get visitors to act.
      </p>
      <div class="hero__actions">
        <a href="/contact?intent=review" class="btn btn--accent btn--lg">Get a Free Website Review</a>
        <a href="/work" class="btn btn--secondary btn--lg">See Our Work</a>
      </div>

      <span class="status hero__status">
        <span class="status__dot"></span>
        Taking on new projects
      </span>

      <p class="hero__meta">
        <span>B2B web design studio</span>
        <span class="hero__meta-dot" aria-hidden="true"></span>
        <span>10+ years</span>
        <span class="hero__meta-dot" aria-hidden="true"></span>
        <span>2,000+ projects</span>
        <span class="hero__meta-dot" aria-hidden="true"></span>
        <span>Webflow + Notion Certified</span>
        <span class="hero__meta-dot" aria-hidden="true"></span>
        <span>Design work for AWS and Fiverr</span>
      </p>
    </div>
  </section>

  <!-- Services: problem-first, no pricing -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head" data-rise>
        <h2>Start with the <span class="accent-word">problem</span> you have</h2>
        <p class="lead">
          Fixed scope, clear timelines, and a process that starts with your
          business, not a template. Pricing is scoped to your project on a
          short call.
        </p>
      </div>

      <div class="grid grid--2">
        {offers.map((offer, i) => (
          <a
            href={`/services/${offer.slug}`}
            class="card offer-card"
            data-rise
            style={`--rise-delay: ${i * 90}ms`}
          >
            <span class="index-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="eyebrow offer-card__problem">{offer.problem}</span>
            <h3 class="offer-card__name">{offer.name}</h3>
            <p class="offer-card__desc">{offer.description}</p>
            <span class="badge badge--delivery">{offer.timeline}</span>
            <span class="offer-card__link link-cue">How it works →</span>
          </a>
        ))}
      </div>

      {roadmap && (
        <a href={`/services/${roadmap.slug}`} class="roadmap-strip" data-rise>
          <div>
            <span class="roadmap-strip__label">{roadmap.problem}</span>
            <span class="roadmap-strip__text">
              Start with a {roadmap.name}: {roadmap.timeline}, and a plan you
              can use with any team.
            </span>
          </div>
          <span class="roadmap-strip__link">Learn more →</span>
        </a>
      )}
    </div>
  </section>

  <!-- Selected work -->
  <section class="section work-preview">
    <div class="container">
      <div class="section-head section-head--row" data-rise>
        <h2>Built, shipped, <span class="accent-word">live</span></h2>
        <a href="/work" class="btn btn--secondary">View All Work</a>
      </div>

      <div class="grid grid--3">
        {projects.map((project, i) => {
          const caseHref =
            Array.isArray(project.body) && project.body.length > 0
              ? `/work/${project.slug}`
              : undefined;
          const external = !caseHref && Boolean(project.url);
          return (
          <a
            href={caseHref ?? project.url ?? "/work"}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="card project-card"
            data-rise
            style={`--rise-delay: ${i * 90}ms`}
          >
            <div class="project-card__cover">
              {project.image ? (
                <img
                  src={project.image}
                  alt={`Screenshot of the ${project.title} website`}
                  loading="lazy"
                  class="project-card__shot"
                />
              ) : (
                <span class="project-card__name">{project.title}</span>
              )}
            </div>
            <div class="project-card__body">
              <span class="project-card__highlight">{project.highlight}</span>
              <h3 class="project-card__title">{project.title}</h3>
              <p class="project-card__summary">{project.summary}</p>
              <span class="project-card__link link-cue">
                {caseHref
                  ? "Read the case study →"
                  : project.url
                    ? "Visit live site ↗"
                    : "See all work →"}
              </span>
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process">
    <div class="container">
      <div class="section-head" data-rise>
        <h2>How we <span class="accent-word">work</span></h2>
        <p class="lead">
          You don't need a perfect brief to start. Bring your current website,
          a rough idea, or the problem you want to solve.
        </p>
      </div>
      <div class="grid grid--4">
        {steps.map((step, i) => (
          <div class="step" data-rise style={`--rise-delay: ${i * 90}ms`}>
            <span class="step__n">{step.n}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </div>
        ))}
      </div>

      <div class="sectors" data-rise>
        <span class="sectors__label">Experience across</span>
        <ul class="sectors__list">
          {sectors.map((s) => (
            <li class="sectors__item">{s}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rise>
        <h2>Word for <span class="accent-word">word</span></h2>
      </div>
      <div class="grid grid--3">
        {testimonials.map((t, i) => (
          <figure class="card quote" data-rise style={`--rise-delay: ${i * 90}ms`}>
            <blockquote class="quote__text">“{t.text}”</blockquote>
            <figcaption class="quote__who">
              <span class="quote__name">{t.name}</span>
              <span class="quote__company">{t.company}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: 120px var(--space-8);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .hero__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(46px, 9vw, 122px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .hero__line {
    display: block;
  }

  .hero__sub {
    max-width: 600px;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .hero__status {
    color: var(--muted);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    width: 100%;
    max-width: none;
    margin-top: var(--space-8);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .hero__meta-dot {
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-text);
  }

  /* Section head row variant */
  .section-head--row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Offer cards: problem-first, no pricing */
  .offer-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .offer-card__problem {
    color: var(--accent-text);
  }

  .offer-card__name {
    font-size: 24px;
  }

  .offer-card__desc {
    font-size: 14px;
    color: var(--muted);
    flex: 1;
  }

  .offer-card__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  .offer-card:hover .offer-card__link {
    color: var(--accent-text);
  }

  /* Roadmap strip */
  .roadmap-strip {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3);
    background: var(--tint);
    border-radius: var(--radius-lg);
  }

  .roadmap-strip__label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 4px;
  }

  .roadmap-strip__text {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }

  .roadmap-strip__link {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  /* Project cards */
  .project-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-card__cover {
    background: var(--ink);
    color: var(--ink-contrast);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-card__shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
  }

  .project-card__highlight {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .project-card__title {
    font-size: 22px;
  }

  .project-card__name {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    padding: var(--space-6) var(--space-2);
  }

  .project-card__body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
    flex: 1;
  }

  .project-card__summary {
    font-size: 14px;
    color: var(--muted);
    flex: 1;
  }

  .project-card__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }

  /* Process steps */
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .step__n {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }

  .step__title {
    font-size: 20px;
  }

  .step__text {
    font-size: 14px;
    color: var(--muted);
  }

  /* Testimonials */
  .quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .quote__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
    flex: 1;
  }

  .quote__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .quote__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
  }

  .quote__company {
    font-size: 13px;
    color: var(--muted);
  }

  /* Sectors */
  .sectors {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .sectors__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .sectors__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2) var(--space-3);
    flex-wrap: wrap;
  }

  .sectors__item {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
