---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { getProjects, getOffers } from "../lib/content";

const projects = (await getProjects()).filter((p) => p.featured).slice(0, 3);
const offers = getOffers();

const steps = [
  {
    n: "01",
    title: "Audit",
    text: "We tear down your current site and show you exactly where conversions are leaking — in dollars, not opinions.",
  },
  {
    n: "02",
    title: "Message",
    text: "We interview your customers and rebuild your copy around the words they actually use to buy.",
  },
  {
    n: "03",
    title: "Design",
    text: "Custom design on a strict system. Every section earns its place or gets cut.",
  },
  {
    n: "04",
    title: "Ship & lift",
    text: "Launch, measure, iterate. You see the numbers move — usually within the first three weeks.",
  },
];
---

<Base title="Dee7 Studio — High-Converting Websites for HealthTech, EdTech & Fintech">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="badge badge--delivery">Design studio for B2B teams</span>
      <h1 class="display hero__title">
        Websites that turn<br class="hero__br" />
        visitors into <span class="hero__title-accent">revenue.</span>
      </h1>
      <p class="lead hero__sub">
        Dee7 designs high-converting landing pages and websites for HealthTech,
        EdTech and Fintech companies. Outcome first, polish always.
      </p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn--accent btn--lg">Get Your Free Audit</a>
        <a href="/work" class="btn btn--ghost-light btn--lg">See the Results</a>
      </div>

      <dl class="hero__stats">
        <div class="hero__stat">
          <dt>Average conversion lift</dt>
          <dd>+38%</dd>
        </div>
        <div class="hero__stat">
          <dt>Pipeline generated for clients</dt>
          <dd>$2.1M+</dd>
        </div>
        <div class="hero__stat">
          <dt>Average time to first lift</dt>
          <dd>21 days</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>Three ways to work with us</h2>
        <p class="lead">
          Start with one page or hand us the whole site. Every engagement is
          priced flat, scoped tight and measured in conversions.
        </p>
      </div>

      <div class="grid grid--3 offers">
        {offers.map((offer) => (
          <article class:list={["card", "offer", { "card--featured": offer.featured }]}>
            {offer.badge && (
              <span class:list={["badge", offer.featured ? "badge--dark" : "badge--accent", "offer__badge"]}>
                {offer.badge}
              </span>
            )}
            <h3 class="offer__name">{offer.name}</h3>
            <p class="offer__desc">{offer.description}</p>
            <div class="offer__price-row">
              <span class="offer__price">{offer.price}</span>
              {offer.cadence && <span class="offer__cadence">{offer.cadence}</span>}
            </div>
            <span class="badge badge--delivery offer__delivery">{offer.delivery}</span>
            <ul class="check-list offer__includes">
              {offer.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a
              href="#contact"
              class:list={["btn", offer.featured ? "btn--accent" : "btn--secondary", "offer__cta"]}
            >
              {offer.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section work-preview">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">Selected Work</span>
          <h2>Results, not mockups</h2>
        </div>
        <a href="/work" class="btn btn--secondary">View All Case Studies</a>
      </div>

      <div class="grid grid--3">
        {projects.map((project) => (
          <a href={`/work/${project.slug}`} class="card project-card">
            <div class="project-card__cover">
              <span class="project-card__metric">{project.metric}</span>
              <span class="project-card__metric-label">{project.metricLabel}</span>
            </div>
            <div class="project-card__body">
              <span class="badge badge--outline">{project.industry}</span>
              <h3 class="project-card__title">{project.client}</h3>
              <p class="project-card__summary">{project.summary}</p>
              <span class="project-card__link">Read the case study →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--dark" id="process">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>From audit to lift in four steps</h2>
      </div>
      <div class="grid grid--4">
        {steps.map((step) => (
          <div class="step">
            <span class="step__n">{step.n}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section">
    <div class="container testimonial">
      <span class="eyebrow">What clients say</span>
      <blockquote class="testimonial__quote">
        “Dee7 rebuilt our landing page in a week. Demo bookings were up 38%
        within the month — it paid for itself before the invoice was due.”
      </blockquote>
      <div class="testimonial__who">
        <span class="testimonial__name">Head of Growth</span>
        <span class="testimonial__role">Calmora Health · HealthTech</span>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    background: var(--ink);
    color: var(--ink-contrast);
    padding-block: 120px var(--space-section);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .hero__title {
    margin-top: var(--space-1);
  }

  .hero__title-accent {
    color: var(--accent);
  }

  .hero__sub {
    max-width: 560px;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    width: 100%;
    margin: var(--space-8) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-on-dark);
  }

  .hero__stat dt {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted-on-dark);
    order: 2;
  }

  .hero__stat dd {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .hero__stats {
      grid-template-columns: 1fr;
    }

    .hero__br {
      display: none;
    }
  }

  /* Section head row variant */
  .section-head--row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .section-head--row h2 {
    margin-top: var(--space-2);
  }

  /* Offers */
  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }

  .offer__badge {
    position: absolute;
    top: -12px;
    left: var(--space-3);
  }

  .offer__name {
    margin-top: var(--space-1);
  }

  .offer__desc {
    font-size: 14px;
    color: var(--muted);
    min-height: 44px;
  }

  .offer__price-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .offer__price {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .offer__cadence {
    font-size: 16px;
    font-weight: 600;
    color: var(--muted);
  }

  .offer__delivery {
    align-self: flex-start;
  }

  .offer__includes {
    margin-block: var(--space-1);
    flex: 1;
  }

  .offer__cta {
    width: 100%;
  }

  /* Project cards */
  .project-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project-card__cover {
    background: var(--ink);
    color: var(--ink-contrast);
    padding: var(--space-6) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 180px;
    justify-content: center;
  }

  .project-card__metric {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }

  .project-card__metric-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted-on-dark);
  }

  .project-card__body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
    flex: 1;
  }

  .project-card__title {
    font-size: 20px;
  }

  .project-card__summary {
    font-size: 14px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__link {
    margin-top: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  /* Process steps */
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-lg);
  }

  .step__n {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }

  .step__title {
    font-size: 20px;
  }

  .step__text {
    font-size: 14px;
    color: var(--muted-on-dark);
  }

  /* Testimonial */
  .testimonial {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .testimonial__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    max-width: 840px;
    text-wrap: balance;
  }

  .testimonial__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial__name {
    font-weight: 700;
    font-size: 14px;
  }

  .testimonial__role {
    font-size: 13px;
    color: var(--muted);
  }
</style>
