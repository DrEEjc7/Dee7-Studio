---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getPosts } from "../../lib/content";
import { renderPortableText } from "../../lib/portableText";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const date = new Date(post.date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const bodyHtml = renderPortableText(post.body);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  ...(post.heroImage ? { image: post.heroImage } : {}),
  author: {
    "@type": "Organization",
    name: "Dee7 Studio",
    url: "https://dee7studio.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Dee7 Studio",
    url: "https://dee7studio.com/",
  },
  mainEntityOfPage: `https://dee7studio.com/blog/${post.slug}`,
};
---

<Base
  title={`${post.seoTitle ?? post.title} | Dee7 Studio`}
  description={post.excerpt}
  image={post.heroImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="post-hero">
      <div class="container post-hero__inner">
        <div class="post-hero__meta">
          <span class="badge badge--tint">{post.category}</span>
          <span class="post-hero__date">{date} · {post.readingTime}</span>
        </div>
        <h1 class="post-hero__title">{post.title}</h1>
        <p class="lead post-hero__excerpt">{post.excerpt}</p>
      </div>
    </header>

    {post.heroImage && (
      <div class="container post-cover">
        <img
          src={post.heroImage}
          alt={`Cover image for ${post.title}`}
          class="post-cover__img"
          loading="eager"
        />
      </div>
    )}

    <div class="container post-body" set:html={bodyHtml} />
  </article>

  <CtaBand
    heading="Want this applied to your site?"
    sub="Get a free teardown. We'll point at the exact sections costing you conversions."
  />
</Base>

<style>
  .post-hero {
    padding-block: var(--space-section) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .post-hero__inner {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .post-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .post-hero__date {
    font-size: 13px;
    color: var(--muted);
  }

  .post-hero__title {
    font-size: clamp(32px, 4.5vw, 48px);
  }

  .post-cover {
    max-width: 800px;
    padding-top: var(--space-6);
  }

  .post-cover__img {
    width: 100%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    display: block;
  }

  .post-body {
    max-width: 688px;
    padding-block: var(--space-6) var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-body :global(p) {
    font-size: 18px;
    line-height: 1.75;
  }

  .post-body :global(h2) {
    font-size: clamp(24px, 3vw, 32px);
    margin-top: var(--space-3);
  }

  .post-body :global(h3) {
    font-size: clamp(20px, 2.4vw, 24px);
    margin-top: var(--space-2);
  }

  .post-body :global(h4) {
    font-size: 18px;
    margin-top: var(--space-1);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-body :global(li) {
    font-size: 18px;
    line-height: 1.65;
  }

  .post-body :global(li::marker) {
    color: var(--accent-text);
    font-weight: 600;
  }

  .post-body :global(blockquote) {
    margin: var(--space-2) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 17px;
    line-height: 1.7;
  }

  .post-body :global(figure) {
    margin: var(--space-2) 0;
  }

  .post-body :global(figure img) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    display: block;
  }

  .post-body :global(figcaption) {
    margin-top: var(--space-1);
    font-size: 13px;
    color: var(--muted);
  }

  .post-body :global(a) {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
  }
</style>
