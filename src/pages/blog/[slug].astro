---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import AvifPicture from "../../components/AvifPicture.astro";
import { getPosts } from "../../lib/content";
import { fallback, socialImage } from "../../lib/images";
import { renderPortableText } from "../../lib/portableText";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const others = posts.filter((p) => p.slug !== post.slug);
    const related = [
      ...others.filter((p) => p.category === post.category),
      ...others.filter((p) => p.category !== post.category),
    ]
      .slice(0, 3)
      .map(({ slug, title, excerpt, category, readingTime }) => ({
        slug,
        title,
        excerpt,
        category,
        readingTime,
      }));
    return { params: { slug: post.slug }, props: { post, related } };
  });
}

const { post, related } = Astro.props;

const categorySlug = (post.category ?? "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");

const bodyHtml = renderPortableText(post.body);

// Google shows about 60 characters of a title. Drop the brand suffix when it would push the title past that.
const baseTitle = post.seoTitle ?? post.title;
const pageTitle = baseTitle.length + " | Dee7 Studio".length <= 60 ? `${baseTitle} | Dee7 Studio` : baseTitle;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.excerpt,
  ...(post.heroImage ? { image: socialImage(post.heroImage) } : {}),
  ...(post.date ? { datePublished: post.date, dateModified: post.date } : {}),
  author: { "@id": "https://dee7studio.com/#organization" },
  publisher: { "@id": "https://dee7studio.com/#organization" },
  mainEntityOfPage: `https://dee7studio.com/blog/${post.slug}`,
};
---

<Base
  title={pageTitle}
  description={post.excerpt}
  image={socialImage(post.heroImage)}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Blog", path: "/blog" },
    { name: post.title, path: `/blog/${post.slug}` },
  ]}
>
  <article>
    <header class="post-hero">
      <div class="container post-hero__inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog" class="crumbs__link">Blog</a>
          <span class="crumbs__sep" aria-hidden="true">/</span>
          <a href={`/blog?category=${categorySlug}`} class="crumbs__link">{post.category}</a>
        </nav>
        <div class="post-hero__meta">
          <span class="post-hero__date">{post.readingTime}</span>
        </div>
        <h1 class="post-hero__title">{post.title}</h1>
        <p class="lead post-hero__excerpt">{post.excerpt}</p>
      </div>
    </header>

    {post.heroImage && (
      <div class="container post-cover">
        <AvifPicture src={post.heroImage} sizes="(max-width: 800px) 100vw, 752px">
          <img
            src={fallback(post.heroImage, 1600)}
            alt={`Cover image for ${post.title}`}
            class="post-cover__img"
            loading="eager"
            fetchpriority="high"
          />
        </AvifPicture>
      </div>
    )}

    <div class="container post-body" set:html={bodyHtml} />

    <div class="container post-after">
      <a href="/blog" class="post-back">← All articles</a>
    </div>

    {related.length > 0 && (
      <section class="related">
        <div class="container">
          <div class="related__head">
            <span class="eyebrow">Keep reading</span>
            <h2 class="related__title">Related articles</h2>
          </div>
          <div class="grid grid--3">
            {related.map((r) => (
              <a href={`/blog/${r.slug}`} class="card related-card">
                <div class="related-card__meta">
                  <span class="badge badge--tint">{r.category}</span>
                  <span class="related-card__time">{r.readingTime}</span>
                </div>
                <h3 class="related-card__title">{r.title}</h3>
                <p class="related-card__excerpt">{r.excerpt}</p>
                <span class="related-card__link link-cue">Read the article →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <CtaBand
    variant="review"
    heading="Want this applied to your site?"
    sub="Get a free teardown. We'll point at the exact sections costing you conversions."
  />
</Base>

<style>
  .post-hero {
    padding-block: var(--space-section) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .post-hero__inner {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
  }

  .crumbs__link {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--ease);
  }

  .crumbs__link:hover {
    color: var(--accent-text);
  }

  .crumbs__sep {
    color: var(--border);
  }

  .post-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .post-hero__date {
    font-size: 13px;
    color: var(--muted);
  }

  .post-hero__title {
    font-size: clamp(32px, 4.5vw, 48px);
  }

  .post-cover {
    max-width: 800px;
    padding-top: var(--space-6);
  }

  .post-cover__img {
    width: 100%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    display: block;
  }

  .post-body {
    max-width: 688px;
    padding-block: var(--space-6) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-after {
    max-width: 688px;
    padding-bottom: var(--space-6);
  }

  .post-back {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: none;
  }

  .post-back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Related articles */
  .related {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6) var(--space-section);
  }

  .related__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .related__title {
    font-size: clamp(24px, 3vw, 32px);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .related-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-2);
  }

  .related-card__time {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .related-card__title {
    font-size: 20px;
    line-height: 1.25;
  }

  .related-card__excerpt {
    font-size: 14px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-card__link {
    margin-top: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }

  .post-body :global(p) {
    font-size: 18px;
    line-height: 1.75;
  }

  .post-body :global(h2) {
    font-size: clamp(24px, 3vw, 32px);
    margin-top: var(--space-3);
  }

  .post-body :global(h3) {
    font-size: clamp(20px, 2.4vw, 24px);
    margin-top: var(--space-2);
  }

  .post-body :global(h4) {
    font-size: 18px;
    margin-top: var(--space-1);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-body :global(li) {
    font-size: 18px;
    line-height: 1.65;
  }

  .post-body :global(li::marker) {
    color: var(--accent-text);
    font-weight: 600;
  }

  .post-body :global(blockquote) {
    margin: var(--space-2) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 17px;
    line-height: 1.7;
  }

  .post-body :global(figure) {
    margin: var(--space-2) 0;
  }

  .post-body :global(figure img) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    display: block;
  }

  .post-body :global(figcaption) {
    margin-top: var(--space-1);
    font-size: 13px;
    color: var(--muted);
  }

  /* Links read as part of the sentence (same ink color as the text around
     them), but a thick, bright accent underline makes them unmistakably
     clickable without relying on color alone. */
  .post-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-skip-ink: none;
    transition: text-decoration-color var(--ease);
  }

  .post-body :global(a:hover) {
    text-decoration-color: var(--accent-text);
  }

  /* A linked screenshot: the whole figure is clickable, but only the
     caption carries the underline cue (an underlined image would be odd). */
  .post-body :global(a.figure-link) {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-body :global(a.figure-link img) {
    transition: border-color var(--ease);
  }

  .post-body :global(a.figure-link:hover img) {
    border-color: var(--accent-text);
  }

  .post-body :global(a.figure-link figcaption) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-skip-ink: none;
    transition: text-decoration-color var(--ease);
  }

  .post-body :global(a.figure-link:hover figcaption) {
    text-decoration-color: var(--accent-text);
  }

  .post-body :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
  }
</style>
