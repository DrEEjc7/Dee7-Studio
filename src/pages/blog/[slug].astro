---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const date = new Date(post.date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<Base title={`${post.title} — Dee7 Studio`} description={post.excerpt}>
  <article>
    <header class="post-hero">
      <div class="container post-hero__inner">
        <div class="post-hero__meta">
          <span class="badge badge--tint">{post.category}</span>
          <span class="post-hero__date">{date} · {post.readingTime}</span>
        </div>
        <h1 class="post-hero__title">{post.title}</h1>
        <p class="lead post-hero__excerpt">{post.excerpt}</p>
      </div>
    </header>

    <div class="container post-body">
      {post.body.map((paragraph) => <p>{paragraph}</p>)}

      <aside class="post-note card">
        <span class="eyebrow">Note</span>
        <p>
          This article uses placeholder content. Once Sanity is connected, the
          body renders from Portable Text.
        </p>
      </aside>
    </div>
  </article>

  <CtaBand
    heading="Want this applied to your site?"
    sub="Get a free teardown — we'll point at the exact sections costing you conversions."
  />
</Base>

<style>
  .post-hero {
    padding-block: var(--space-section) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .post-hero__inner {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .post-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .post-hero__date {
    font-size: 13px;
    color: var(--muted);
  }

  .post-hero__title {
    font-size: clamp(32px, 4.5vw, 48px);
  }

  .post-body {
    max-width: 688px;
    padding-block: var(--space-6) var(--space-section);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-body p {
    font-size: 18px;
    line-height: 1.75;
  }

  .post-note {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-note p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
