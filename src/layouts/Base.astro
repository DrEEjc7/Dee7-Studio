---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { SITE, abs, trimDescription } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image / twitter card */
  image?: string;
  /** og:type, defaults to "website"; posts pass "article" */
  ogType?: string;
  /** JSON-LD objects rendered into <head> */
  jsonLd?: object | object[];
  /** Trail below Home, e.g. [{ name: "Blog", path: "/blog" }]. Emits BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[];
  /** Keep the page out of search results (404 etc.) */
  noindex?: boolean;
}

const {
  title,
  description: rawDescription = SITE.description,
  image,
  ogType = "website",
  jsonLd,
  breadcrumbs,
  noindex = false,
} = Astro.props;

const description = trimDescription(rawDescription);
const socialImage = image ?? abs(SITE.ogImage);

// With build.format "file", Astro.url.pathname ends in .html at build time.
// The canonical must be the clean public URL.
const cleanPath = Astro.url.pathname.replace(/\/?index\.html$/, "/").replace(/\.html$/, "");
const canonical = Astro.site ? new URL(cleanPath, Astro.site).href : undefined;

// Site-wide entities. Stable @ids let page-level schema (Article, Service...)
// point back at the same organisation.
const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: abs("/brand/Square_2.svg"),
      image: abs(SITE.ogImage),
      email: SITE.email,
      description: SITE.description,
      slogan: SITE.tagline,
      areaServed: "Worldwide",
      knowsAbout: [
        "Web design",
        "Webflow development",
        "Website copywriting",
        "Conversion optimization",
        "Notion",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      url: `${SITE.url}/`,
      publisher: { "@id": `${SITE.url}/#organization` },
      inLanguage: "en",
      potentialAction: {
        "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: `${SITE.url}/blog?q={search_term_string}` },
        "query-input": "required name=search_term_string",
      },
    },
  ],
};

const breadcrumbLd = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.name,
        item: abs(crumb.path),
      })),
    }
  : null;

const jsonLdBlocks = [
  siteGraph,
  ...(breadcrumbLd ? [breadcrumbLd] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#FAF7F0" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/brand/Square_2.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Dee7 Studio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      const els = document.querySelectorAll("[data-rise]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Reveal when entering, and also when already scrolled past
              // (fast scrolls and restored scroll positions).
              if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                entry.target.classList.add("is-risen");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: "0px 0px 160px 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-risen"));
      }
    </script>
  </body>
</html>
